# =============================================================================
# SolFlow Environment Variables
# =============================================================================

# Database
DATABASE_URL=""

# Auth.js
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# Cloud wallet/credential encryption
ENCRYPTION_MASTER_KEY="your-encryption-master-key"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Docker compiler service
COMPILER_SERVICE_URL="http://localhost:4000"

# Editor AI assistant (optional; falls back locally without a key)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
