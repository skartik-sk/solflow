# =============================================================================
# SolFlow Environment Variables
# =============================================================================

# Database
DATABASE_URL=""

# Auth.js
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# Cloud wallet/credential encryption
ENCRYPTION_MASTER_KEY="your-encryption-master-key"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"

# Marketplace payments (treasury unset = purchases refused)
SOLFLOW_TREASURY_WALLET=""
# "mainnet-beta" (default) or "devnet" for testing; RPC is optional
SOLFLOW_PAYMENT_CLUSTER=""
SOLFLOW_PAYMENT_RPC_URL=""
# Comma-separated emails allowed to approve/reject marketplace listings
ADMIN_EMAILS=""

# Redis (optional: BullMQ for long-running Cloud workers only; serverless runs need none)
REDIS_URL="redis://localhost:6379"

# Cloud cron (Upstash QStash). Required for cron triggers on serverless.
# /api/cron/fire verifies the Upstash-Signature with the signing keys; in
# production it refuses every call if neither the keys nor CRON_SECRET are set.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Public base URL of the Cloud app (QStash schedule destination)
CLOUD_PUBLIC_BASE_URL=""
# Optional shared secret (X-Cron-Secret / Authorization: Bearer); also guards /api/cron/reconcile
CRON_SECRET=""

# Docker compiler service
COMPILER_SERVICE_URL="http://localhost:4000"

# Editor AI assistant (optional; falls back locally without a key)
# Groq is used first when set (free tier: console.groq.com/keys), then Gemini.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
