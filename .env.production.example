# =============================================================================
# SolFlow — Production Environment Variables
# Copy to .env.production and fill in your values
# =============================================================================

# Database
DATABASE_URL=""

# Auth.js — generate secret: openssl rand -base64 32
AUTH_SECRET=""
# Keep OAuth callbacks on the root domain; Cloud passes an absolute cloud
# callbackUrl after login so users still land on cloud.solstudio.fun.
AUTH_URL="https://solstudio.fun"
AUTH_TRUST_HOST="true"
# Share one login session across solstudio.fun and cloud.solstudio.fun.
AUTH_COOKIE_DOMAIN=".solstudio.fun"

# Cloud wallet/credential encryption — generate secret: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"

# Marketplace payments (treasury unset = purchases refused)
SOLFLOW_TREASURY_WALLET=""
# "mainnet-beta" (default) or "devnet" for testing; RPC is optional
SOLFLOW_PAYMENT_CLUSTER=""
SOLFLOW_PAYMENT_RPC_URL=""
# Comma-separated emails allowed to approve/reject marketplace listings
ADMIN_EMAILS=""

# Redis (runs in docker-compose, or use external; not needed on Vercel/serverless)
REDIS_URL="redis://redis:6379"

# Cloud runtime
# api = UI/API/webhooks only, worker = execution workers only, all = dev single process
CLOUD_RUNTIME_MODE="api"

# Optional Cloud quota gate for launch/trial plans. Leave disabled until billing is ready.
CLOUD_QUOTA_ENFORCEMENT="false"
CLOUD_FREE_ACTIVE_WORKFLOWS="1"
CLOUD_TRIAL_DAYS="7"

# Cloud cron (Upstash QStash). Required for cron triggers on serverless.
# /api/cron/fire verifies the Upstash-Signature with the signing keys; in
# production it refuses every call if neither the keys nor CRON_SECRET are set.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Public base URL of the Cloud app (QStash schedule destination)
CLOUD_PUBLIC_BASE_URL=""
# Optional shared secret (X-Cron-Secret / Authorization: Bearer); also guards /api/cron/reconcile
CRON_SECRET=""

# Public app URLs
NEXT_PUBLIC_APP_URL="https://solstudio.fun"
NEXT_PUBLIC_CLOUD_URL="https://cloud.solstudio.fun"
NEXT_PUBLIC_WEB_URL="https://solstudio.fun"

# Compiler (uses sol-pg cloud build API by default)
# The root docker-compose starts solflow-compiler and shares this build dir.
SOLFLOW_BUILD_DIR="/tmp/solflow-builds"

# Editor AI assistant (optional; falls back locally without a key)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: public URL for sitemap, OAuth callbacks
