# =============================================================================
# SolFlow — Production Environment Variables
# Copy to .env.production and fill in your values
# =============================================================================

# Database (Neon PostgreSQL — already set up)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js — generate secret: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://YOUR_VPS_IP:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"

# Redis (runs in docker-compose, or use external)
REDIS_URL="redis://redis:6379"

# Compiler (uses sol-pg cloud build API by default)
# Set this only if you run your own compiler Docker on this VPS
# COMPILER_SERVICE_URL="http://localhost:4000"

# Optional: public URL for sitemap, OAuth callbacks
NEXT_PUBLIC_APP_URL="http://YOUR_VPS_IP:3000"
