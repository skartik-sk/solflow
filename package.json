{
  "name": "solflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "solstudio": "bun run packages/cli/src/index.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:codegen": "turbo test:codegen",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:cloud-seed": "bun run --cwd packages/db db:cloud-seed",
    "db:seed:all": "bun run db:seed && bun run db:cloud-seed",
    "clean": "turbo clean && rm -rf node_modules",
    "postinstall": "bun run --cwd packages/db db:generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "prettier": "^3.5.0",
    "@solflow/eslint-config": "workspace:*",
    "@solflow/tsconfig": "workspace:*",
    "eslint": "^9.0.0"
  },
  "packageManager": "bun@1.3.10"
}
