[package]
name = "{{kebabName}}"
version = "{{version}}"
description = "Created with SolFlow"
edition = "2021"

[lib]
crate-type = ["cdylib", "lib"]
name = "{{snakeName}}"

[features]
no-entrypoint = []
no-idl = []
no-log-ix-name = []
cpi = ["no-entrypoint"]
default = []
idl-build = ["anchor-lang/idl-build"]

[dependencies]
anchor-lang = { version = "0.32.0", features = ["init-if-needed"] }
{{#if usesSpl}}
anchor-spl = "0.32.0"
{{/if}}

[profile.release]
opt-level = "z"
overflow-checks = true
lto = "fat"
codegen-units = 1
