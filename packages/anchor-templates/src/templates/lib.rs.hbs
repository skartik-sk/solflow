use anchor_lang::prelude::*;

{{#each modules}}
pub mod {{this}};
{{/each}}

{{#if programId}}
declare_id!("{{programId}}");
{{else}}
declare_id!("11111111111111111111111111111111");
{{/if}}

#[program]
pub mod {{programName}} {
    use super::*;

    {{#each instructions}}
    pub fn {{name}}(ctx: Context<{{contextStruct}}>{{#if args}}, {{#each args}}{{name}}: {{type}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}) -> Result<()> {
        instructions::{{name}}::handler(ctx{{#if args}}, {{#each args}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}})
    }
    {{/each}}
}
