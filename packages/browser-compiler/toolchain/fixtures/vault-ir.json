          "type": "transfer-sol",
          "from": "authority",
          "to": "vault",
          "amount": "amount"
        },
        {
          "type": "math",
          "operation": "add",
          "left": "vault.balance",
          "right": "amount",
          "result": "new_balance",
          "checked": true
        },
        {
          "type": "set-field",
          "account": "vault",
          "field": "balance",
          "value": "new_balance"
        },
        {
          "type": "emit-event",
          "event": "DepositEvent",
          "fields": {
            "authority": "*ctx.accounts.authority.key",
            "amount": "amount",
            "new_balance": "new_balance"
          }
        }
      ]
    },
    {
      "id": "i3",
      "name": "withdraw",
      "accessControl": "none",
      "args": [
        {
          "name": "amount",
          "type": "u64"
        }
      ],
      "accounts": [
        {
          "id": "a7",
          "name": "vault",
          "accountType": "account",
          "stateType": "VaultState",
          "constraints": [
