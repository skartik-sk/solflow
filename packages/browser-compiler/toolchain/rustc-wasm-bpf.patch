+++ b/compiler/rustc_llvm/llvm-wrapper/WasiStubs.cpp
@@ -0,0 +1,13 @@
+// WASI has no dynamic loading. LLVM's plugin loader still references these, so a wasm-hosted
+// rustc gets stubs that fail cleanly; the code paths are never used for normal compilation.
+#if defined(__wasi__)
+#include <stddef.h>
+
+extern "C" {
+void *dlopen(const char *, int) { return NULL; }
+void *dlsym(void *, const char *) { return NULL; }
+int dlclose(void *) { return 0; }
+char *dlerror(void) { return const_cast<char *>("dynamic loading is not supported on WASI"); }
+int posix_madvise(void *, size_t, int) { return 0; }
+}
+#endif
