+/// A wasm-hosted rustc can't dlopen. Proc-macro crates linked into the compiler binary
+/// register their `__rustc_proc_macro_decls_*` symbol here instead.
+#[cfg(target_os = "wasi")]
+static STATIC_SYMBOLS: std::sync::Mutex<Vec<(String, usize)>> = std::sync::Mutex::new(Vec::new());
+
+#[cfg(target_os = "wasi")]
+pub fn register_static_symbol(name: &str, addr: usize) {
+    STATIC_SYMBOLS.lock().unwrap().push((name.to_owned(), addr));
+}
+
+#[cfg(target_os = "wasi")]
+pub unsafe fn load_symbol_from_dylib<T: Copy>(
+    path: &Path,
+    sym_name: &str,
+) -> Result<T, DylibError> {
+    const { assert!(size_of::<T>() == size_of::<usize>()) };
+    let addr = STATIC_SYMBOLS.lock().unwrap().iter().find(|(n, _)| n == sym_name).map(|(_, a)| *a);
+    match addr {
+        Some(addr) => Ok(unsafe { std::mem::transmute_copy::<usize, T>(&addr) }),
+        None => Err(DylibError::DlOpen(
+            path.display().to_string(),
+            "this compiler can't load proc-macro libraries".to_owned(),
+        )),
+    }
+}
