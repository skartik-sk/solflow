@@ -0,0 +1,45 @@
+//! `libloading` has no WASI backend. A wasm-hosted rustc can't dlopen, so on WASI these stubs
+//! fail the same way a missing library does, and Enzyme/offload report as unavailable.
+
+#[cfg(not(target_os = "wasi"))]
+pub(crate) use libloading::{Error, Library, Symbol};
+#[cfg(target_os = "wasi")]
+pub(crate) use self::wasi::{Error, Library, Symbol};
+
+#[cfg(target_os = "wasi")]
+mod wasi {
+    use std::ffi::c_void;
+    use std::marker::PhantomData;
+
+    pub(crate) use libloading::Error;
+
+    pub(crate) struct Library;
+
+    pub(crate) struct Symbol<'lib, T> {
+        value: T,
+        _lib: PhantomData<&'lib Library>,
+    }
+
+    impl Library {
+        pub(crate) unsafe fn new<P>(_path: P) -> Result<Library, Error> {
+            Err(Error::DlOpenUnknown)
+        }
+
+        pub(crate) unsafe fn get<T>(&self, _symbol: &[u8]) -> Result<Symbol<'_, T>, Error> {
+            Err(Error::DlSymUnknown)
+        }
+    }
+
+    impl<T> std::ops::Deref for Symbol<'_, T> {
+        type Target = T;
+        fn deref(&self) -> &T {
+            &self.value
+        }
+    }
+
+    impl<T> Symbol<'_, T> {
+        pub(crate) fn try_as_raw_ptr(self) -> Option<*mut c_void> {
+            None
+        }
+    }
+}
