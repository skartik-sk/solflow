{
  "name": "@solstudio/cli",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "SolStudio CLI for parsing, visualizing, testing, and auditing local Solana projects.",
  "type": "module",
  "bin": {
    "solstudio": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "static",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "pack:dry": "bun run build && npm pack --dry-run",
    "publish:check": "bun run typecheck && bun run test && bun run pack:dry",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:standalone": "cd ../../apps/standalone && bun run build && mkdir -p ../../packages/cli/static && cp -r out/* ../../packages/cli/static/"
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@solflow/tsconfig": "workspace:*",
    "@solflow/eslint-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "@types/cors": "^2.8.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
