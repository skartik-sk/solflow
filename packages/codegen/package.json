    "@solflow/pinocchio-templates": "workspace:*",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@solflow/tsconfig": "workspace:*",
    "@solflow/eslint-config": "workspace:*",
    "@types/handlebars": "*",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
