{
  "version": "1.0.0",
  "program": {
    "name": "token_vault",
    "description": "A token vault program that lets users deposit, withdraw, and close SPL token vaults backed by PDA accounts",
    "version": "0.1.0",
    "programId": "TokenVault11111111111111111111111111111111111"
  },
  "instructions": [
    {
      "id": "a1000000-0000-0000-0000-000000000001",
      "name": "initialize",
      "description": "Initialize a new token vault PDA from user + mint seeds, create vault token account",
      "accessControl": "none",
      "args": [],
      "accounts": [
        {
          "id": "a1000000-0000-0000-0000-000000000010",
          "name": "vault",
          "accountType": "account",
          "stateType": "VaultState",
          "constraints": [
            { "type": "init", "payer": "authority", "space": "auto" },
            {
              "type": "seeds",
              "seeds": [
                { "type": "literal", "value": "vault" },
                { "type": "account-field", "value": "authority" },
                { "type": "account-field", "value": "mint" }
              ],
              "bump": "vault.bump"
            }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000011",
          "name": "authority",
          "accountType": "signer",
          "constraints": [{ "type": "signer" }]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000012",
          "name": "vault_token_account",
          "accountType": "associated-token",
          "constraints": [
            { "type": "init", "payer": "authority", "space": "auto" },
            { "type": "associated-token-authority", "authority": "vault" },
            { "type": "associated-token-mint", "mint": "mint" }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000013",
          "name": "mint",
          "accountType": "mint",
          "constraints": []
        },
        {
          "id": "a1000000-0000-0000-0000-000000000014",
          "name": "token_program",
          "accountType": "token-program",
          "constraints": []
        },
        {
          "id": "a1000000-0000-0000-0000-000000000015",
          "name": "associated_token_program",
          "accountType": "associated-token-program",
          "constraints": []
        },
        {
          "id": "a1000000-0000-0000-0000-000000000016",
          "name": "system_program",
          "accountType": "system-program",
          "constraints": []
        }
      ],
      "body": [
        { "type": "set-field", "account": "vault", "field": "authority", "value": "*ctx.accounts.authority.key" },
        { "type": "set-field", "account": "vault", "field": "mint", "value": "*ctx.accounts.mint.key" },
        { "type": "set-field", "account": "vault", "field": "amount", "value": "0" },
        { "type": "set-field", "account": "vault", "field": "bump", "value": "ctx.bumps.vault" }
      ]
    },
    {
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "deposit",
      "description": "Deposit SPL tokens from user to vault",
      "accessControl": "none",
      "args": [
        { "name": "amount", "type": "u64", "description": "Amount of tokens to deposit" }
      ],
      "accounts": [
        {
          "id": "a1000000-0000-0000-0000-000000000020",
          "name": "vault",
          "accountType": "account",
          "stateType": "VaultState",
          "constraints": [
            { "type": "mut" },
            {
              "type": "seeds",
              "seeds": [
                { "type": "literal", "value": "vault" },
                { "type": "account-field", "value": "authority" },
                { "type": "account-field", "value": "mint" }
              ],
              "bump": "vault.bump"
            }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000021",
          "name": "authority",
          "accountType": "signer",
          "constraints": [{ "type": "signer" }]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000022",
          "name": "user_token_account",
          "accountType": "token-account",
          "constraints": [
            { "type": "mut" },
            { "type": "token-authority", "authority": "authority" },
            { "type": "token-mint", "mint": "mint" }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000023",
          "name": "vault_token_account",
          "accountType": "token-account",
          "constraints": [
            { "type": "mut" }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000024",
          "name": "mint",
          "accountType": "mint",
          "constraints": []
        },
        {
          "id": "a1000000-0000-0000-0000-000000000025",
          "name": "token_program",
          "accountType": "token-program",
          "constraints": []
        }
      ],
      "body": [
        { "type": "require", "condition": "amount > 0", "errorCode": "InvalidAmount" },
        { "type": "transfer-token", "from": "user_token_account", "to": "vault_token_account", "authority": "authority", "amount": "amount" },
        { "type": "math", "operation": "add", "left": "vault.amount", "right": "amount", "result": "new_amount", "checked": true },
        { "type": "set-field", "account": "vault", "field": "amount", "value": "new_amount" },
        { "type": "emit-event", "event": "DepositEvent", "fields": { "authority": "*ctx.accounts.authority.key", "amount": "amount", "new_total": "new_amount" } }
      ]
    },
    {
      "id": "a1000000-0000-0000-0000-000000000003",
      "name": "withdraw",
      "description": "Withdraw SPL tokens from vault back to user (signed by vault PDA)",
      "accessControl": "none",
      "args": [
        { "name": "amount", "type": "u64", "description": "Amount of tokens to withdraw" }
      ],
      "accounts": [
        {
          "id": "a1000000-0000-0000-0000-000000000030",
          "name": "vault",
          "accountType": "account",
          "stateType": "VaultState",
          "constraints": [
            { "type": "mut" },
            { "type": "has-one", "field": "authority", "target": "authority", "errorCode": "Unauthorized" },
            {
              "type": "seeds",
              "seeds": [
                { "type": "literal", "value": "vault" },
                { "type": "account-field", "value": "authority" },
                { "type": "account-field", "value": "mint" }
              ],
              "bump": "vault.bump"
            }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000031",
          "name": "authority",
          "accountType": "signer",
          "constraints": [{ "type": "signer" }]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000032",
          "name": "user_token_account",
          "accountType": "token-account",
          "constraints": [
            { "type": "mut" }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000033",
          "name": "vault_token_account",
          "accountType": "token-account",
          "constraints": [
            { "type": "mut" },
            { "type": "token-authority", "authority": "vault" }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000034",
          "name": "token_program",
          "accountType": "token-program",
          "constraints": []
        }
      ],
      "body": [
        { "type": "require", "condition": "amount > 0", "errorCode": "InvalidAmount" },
        { "type": "require", "condition": "vault.amount >= amount", "errorCode": "InsufficientFunds" },
        {
          "type": "transfer-token",
          "from": "vault_token_account",
          "to": "user_token_account",
          "authority": "vault",
          "amount": "amount",
          "signerSeeds": [
            { "type": "literal", "value": "vault" },
            { "type": "account-field", "value": "authority" },
            { "type": "account-field", "value": "mint" },
            { "type": "literal", "value": "vault.bump" }
          ]
        },
        { "type": "math", "operation": "sub", "left": "vault.amount", "right": "amount", "result": "remaining", "checked": true },
        { "type": "set-field", "account": "vault", "field": "amount", "value": "remaining" },
        { "type": "emit-event", "event": "WithdrawEvent", "fields": { "authority": "*ctx.accounts.authority.key", "amount": "amount", "remaining": "remaining" } }
      ]
    },
    {
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "close_vault",
      "description": "Close the vault account and return rent to the authority",
      "accessControl": "none",
      "args": [],
      "accounts": [
        {
          "id": "a1000000-0000-0000-0000-000000000040",
          "name": "vault",
          "accountType": "account",
          "stateType": "VaultState",
          "constraints": [
            { "type": "mut" },
            { "type": "close", "target": "authority" },
            { "type": "has-one", "field": "authority", "target": "authority", "errorCode": "Unauthorized" },
            {
              "type": "seeds",
              "seeds": [
                { "type": "literal", "value": "vault" },
                { "type": "account-field", "value": "authority" },
                { "type": "account-field", "value": "mint" }
              ],
              "bump": "vault.bump"
            }
          ]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000041",
          "name": "authority",
          "accountType": "signer",
          "constraints": [{ "type": "signer" }]
        },
        {
          "id": "a1000000-0000-0000-0000-000000000042",
          "name": "system_program",
          "accountType": "system-program",
          "constraints": []
        }
      ],
      "body": [
        { "type": "require", "condition": "vault.amount == 0", "errorCode": "VaultNotEmpty" },
        { "type": "emit-event", "event": "CloseVaultEvent", "fields": { "authority": "*ctx.accounts.authority.key" } }
      ]
    }
  ],
  "states": [
    {
      "id": "b1000000-0000-0000-0000-000000000001",
      "name": "VaultState",
      "isZeroCopy": false,
      "fields": [
        { "name": "authority", "type": "Pubkey", "description": "Vault owner who can withdraw and close" },
        { "name": "mint", "type": "Pubkey", "description": "The SPL token mint this vault holds" },
        { "name": "amount", "type": "u64", "description": "Total tokens currently deposited in the vault" },
        { "name": "bump", "type": "u8", "description": "PDA bump seed for signing" }
      ]
    }
  ],
  "errors": [
    { "id": "c1000000-0000-0000-0000-000000000001", "name": "InvalidAmount", "code": 6000, "message": "Amount must be greater than 0" },
    { "id": "c1000000-0000-0000-0000-000000000002", "name": "InsufficientFunds", "code": 6001, "message": "Insufficient tokens in vault" },
    { "id": "c1000000-0000-0000-0000-000000000003", "name": "Unauthorized", "code": 6002, "message": "Only the vault authority can perform this action" },
    { "id": "c1000000-0000-0000-0000-000000000004", "name": "VaultNotEmpty", "code": 6003, "message": "Cannot close a vault that still holds tokens" }
  ],
  "events": [
    {
      "id": "d1000000-0000-0000-0000-000000000001",
      "name": "DepositEvent",
      "fields": [
        { "name": "authority", "type": "Pubkey" },
        { "name": "amount", "type": "u64" },
        { "name": "new_total", "type": "u64" }
      ]
    },
    {
      "id": "d1000000-0000-0000-0000-000000000002",
      "name": "WithdrawEvent",
      "fields": [
        { "name": "authority", "type": "Pubkey" },
        { "name": "amount", "type": "u64" },
        { "name": "remaining", "type": "u64" }
      ]
    },
    {
      "id": "d1000000-0000-0000-0000-000000000003",
      "name": "CloseVaultEvent",
      "fields": [
        { "name": "authority", "type": "Pubkey" }
      ]
    }
  ],
  "integrations": [],
  "constants": [],
  "metadata": {
    "createdAt": "2026-04-17T00:00:00.000Z",
    "updatedAt": "2026-04-17T00:00:00.000Z",
    "flowHash": "token_vault_template",
    "generatorVersion": "0.1.0"
  }
}
