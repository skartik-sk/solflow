    "db:cloud-seed": "bun prisma/cloud-seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@solflow/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.8.0"
  }
}
