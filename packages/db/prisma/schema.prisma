generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js required models ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  walletAddress String?   @unique
  deployerKeypair String?  // Encrypted persistent deploy wallet payload (legacy rows may contain bs58 until migrated on read)
  authProvider  AuthProvider @default(GOOGLE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  projects     Project[]
  projectShares ProjectShare[]
  deployments  Deployment[]
  marketplaceListings  MarketplaceListing[]
  marketplacePurchases MarketplacePurchase[]
  apiKeys      ApiKey[]

  cloudWallets      CloudWallet[]
  cloudCredentials  CloudCredential[]
  workflows         Workflow[]
  templateAuthor    WorkflowTemplate[]

  @@index([email])
  @@index([walletAddress])
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
  WALLET
}

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── Projects ──────────────────────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  framework     Framework
  status        ProjectStatus @default(DRAFT)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  flowData        Json
  irData          Json?
  generatedCode   Json?
  programKeypair  String? // Encrypted program identity payload (legacy rows may contain bs58 until migrated on deploy)

  snapshots    ProjectSnapshot[]
  deployments  Deployment[]
  compilations Compilation[]
  auditReports AuditReport[]
  testRuns     TestRun[]
  shares       ProjectShare[]

  listing    MarketplaceListing?
  forkedFrom String?

  @@index([userId])
  @@index([status])
  @@index([framework])
}

model ProjectShare {
  id          String   @id @default(cuid())
  slug        String   @unique
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  flowData    Json
  irData      Json?
  auditSummary Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revokedAt   DateTime?

  @@index([projectId])
  @@index([userId])
  @@index([revokedAt])
}

enum Framework {
  ANCHOR
  PINOCCHIO
  QUASAR
}

enum ProjectStatus {
  DRAFT
  COMPILED
  TESTED
  DEPLOYED
  ARCHIVED
}

// ─── Version Control ───────────────────────────────────────────────

model ProjectSnapshot {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  version     Int
  label       String?
  description String?

  flowData Json
  irData   Json?
  flowHash String

  diffData Json?

  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId])
}

// ─── Compilations ──────────────────────────────────────────────────

model Compilation {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status    CompilationStatus
  framework Framework
  irHash    String
  logs      String?
  errors    Json?
  warnings  Json?

  binaryUrl  String?
  binarySize Int?
  idlData    Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?

  @@index([projectId])
  @@index([status])
}

enum CompilationStatus {
  QUEUED
  BUILDING
  SUCCESS
  FAILED
}

// ─── Deployments ───────────────────────────────────────────────────

model Deployment {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id])

  network        Network
  programId      String
  programKeypair String? // Encrypted deployment program identity payload
  txSignature    String
  slot           BigInt?

  irHash     String
  binaryHash String

  status      DeploymentStatus
  explorerUrl String?

  deployedAt DateTime  @default(now())
  upgradedAt DateTime?

  @@index([projectId])
  @@index([userId])
  @@index([network])
  @@index([programId])
}

enum Network {
  DEVNET
  MAINNET
  LOCALNET
}

enum DeploymentStatus {
  PENDING
  CONFIRMED
  FAILED
  UPGRADED
  CLOSED
}

// ─── Test Runs ─────────────────────────────────────────────────────

model TestRun {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status    TestStatus
  testCases Json
  results   Json?
  summary   Json?
  logs      String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?

  @@index([projectId])
}

enum TestStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
}

// ─── Audit Reports ─────────────────────────────────────────────────

model AuditReport {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  irHash   String
  findings Json
  summary  Json
  score    Int?

  auditType AuditType
  createdAt DateTime  @default(now())

  @@index([projectId])
}

enum AuditType {
  STATIC_ANALYSIS
  EXTERNAL_API
}

// ─── Marketplace ───────────────────────────────────────────────────

model MarketplaceListing {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])

  title           String
  description     String
  longDescription String?
  category        TemplateCategory
  tags            String[]
  thumbnailUrl    String?
  previewImages   String[]

  pricingModel PricingModel
  priceSOL     Float?
  priceUSD     Float?

  downloads Int   @default(0)
  forks     Int   @default(0)
  likes     Int   @default(0)
  rating    Float?

  templateFlowData Json
  templateIR       Json

  status   ListingStatus @default(PENDING_REVIEW)
  featured Boolean       @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  purchases MarketplacePurchase[]
  reviews   MarketplaceReview[]

  @@index([category])
  @@index([status])
  @@index([authorId])
  @@index([featured])
  @@index([downloads])
}

enum TemplateCategory {
  TOKEN
  NFT
  DEFI
  DAO
  GAMING
  SOCIAL
  UTILITY
  OTHER
}

enum PricingModel {
  FREE
  PAID
  PAY_WHAT_YOU_WANT
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

model MarketplacePurchase {
  id        String             @id @default(cuid())
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User               @relation(fields: [buyerId], references: [id])

  txSignature String?
  amount      Float?
  currency    String?

  createdAt DateTime @default(now())

  @@unique([listingId, buyerId])
  @@index([buyerId])
}

model MarketplaceReview {
  id         String             @id @default(cuid())
  listingId  String
  listing    MarketplaceListing @relation(fields: [listingId], references: [id])
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime           @default(now())

  @@unique([listingId, reviewerId])
  @@index([listingId])
}

// ─── Cloud Workflow Models ────────────────────────────────────────────────────

model CloudWallet {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  publicKey    String
  encryptedKey String   @db.Text
  keyIv        String
  keyTag       String
  keySalt      String
  network      String   @default("mainnet")
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workflows    Workflow[]

  @@unique([userId, label])
  @@index([userId])
  @@index([publicKey])
}

model CloudCredential {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  type          String
  encryptedData String   @db.Text
  dataIv        String
  dataTag       String
  dataSalt      String
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, label])
  @@index([userId])
  @@index([type])
}

model Workflow {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         CloudWorkflowStatus @default(DRAFT)
  definition     Json
  settings       Json      @default("{}")
  cronExpression String?
  cronTimezone   String?
  nextRunAt      DateTime?
  webhookPath    String?   @unique
  webhookSecret  String?
  tags           String[]
  walletId       String?
  wallet         CloudWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  executions     WorkflowExecution[]
  versions       WorkflowVersion[]

  @@index([userId])
  @@index([status])
  @@index([nextRunAt])
}

enum CloudWorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
  PAUSED
  ARCHIVED
}

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version     Int
  label       String?
  definition  Json
  settings    Json
  createdAt   DateTime @default(now())

  @@unique([workflowId, version])
  @@index([workflowId])
}

model WorkflowExecution {
  id                 String            @id @default(cuid())
  workflowId         String
  workflow           Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status             CloudExecutionStatus @default(QUEUED)
  triggerType        String
  triggerData        Json?
  startedAt          DateTime?
  completedAt        DateTime?
  duration           Int?
  nodesExecuted      Int               @default(0)
  nodesSucceeded     Int               @default(0)
  nodesFailed        Int               @default(0)
  executionData      Json?
  definitionSnapshot Json?
  errorMessage       String?
  jobId              String?
  createdAt          DateTime          @default(now())

  nodeResults        NodeExecution[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
  @@index([workflowId, createdAt])
}

enum CloudExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

model NodeExecution {
  id             String            @id @default(cuid())
  executionId    String
  execution      WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId         String
  nodeType       String
  status         CloudNodeExecutionStatus @default(QUEUED)
  inputSnapshot  Json?
  outputSnapshot Json?
  duration       Int?
  error          String?
  logs           Json?
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([executionId])
  @@index([executionId, nodeId])
}

enum CloudNodeExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  WAITING
}

model WorkflowTemplate {
  id              String   @id @default(cuid())
  title           String
  description     String
  longDescription String?
  category        String
  tags            String[]
  thumbnailUrl    String?
  definition      Json
  settings        Json     @default("{}")
  nodeTypes       String[]
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id])
  downloads       Int      @default(0)
  likes           Int      @default(0)
  rating          Float?
  featured        Boolean  @default(false)
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([downloads])
}
